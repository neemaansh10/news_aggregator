# Copy to `.env` to override defaults. Every setting is also accepted as an
# environment variable with the same name.

# --- Runtime --------------------------------------------------------------
NEWSAGG_ENVIRONMENT=local
NEWSAGG_LOG_LEVEL=INFO
NEWSAGG_LOG_JSON=false

# --- Storage --------------------------------------------------------------
# SQLite by default so the project runs with no external services.
NEWSAGG_DATABASE_URL=sqlite+aiosqlite:///./newsagg.db
# NEWSAGG_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/newsagg

# Optional: shared cache. Falls back to an in-process LRU when unset.
# NEWSAGG_REDIS_URL=redis://localhost:6379/0

# --- Event bus ------------------------------------------------------------
NEWSAGG_EVENT_BUS=memory          # memory | kafka
# NEWSAGG_KAFKA_BOOTSTRAP=localhost:9092

# --- API ------------------------------------------------------------------
NEWSAGG_API_HOST=127.0.0.1
NEWSAGG_API_PORT=8000

# --- Tuning (see SYSTEM_DESIGN.md section 6 for how these were calibrated) --
NEWSAGG_ASSIGN_THRESHOLD=0.30     # article -> story
NEWSAGG_MERGE_THRESHOLD=0.26      # story  -> story
NEWSAGG_NEAR_DUP_JACCARD=0.45     # MinHash within-cluster duplicate
NEWSAGG_SIMHASH_HAMMING_MAX=7     # LSH near-duplicate
NEWSAGG_HALF_LIFE_H=8.0           # recency decay
NEWSAGG_SYNDICATION_DISCOUNT=0.35
